{
  "name": "matico",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "./matico_spec",
    "./matico_components",
    "./matico_types",
    "./matico_admin",
    "./matico_app_server",
    "./matico_charts",
    "./editor"
  ],
  "devDependencies": {
    "@types/node": "^14.11.2",
    "concurrently": "^7.3.0",
    "husky": "8.0.2",
    "next": "12.2.0",
    "prettier": "2.7.1",
    "typescript": "~4.7.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm --filter @maticoapp/matico_charts run build-prod  && pnpm --filter @maticoapp/matico_components build-prod  &&  (cd matico_app_server && pnpm prisma generate && pnpm build )"
  },
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "concurrently": "^7.3.0"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "@types/react": "18.2.0",
      "@types/react-dom": "18.2.0",
      "@adobe/react-spectrum": "3.36.0",
      "@react-spectrum/*": "3.36.0",
      "@react-aria/*": "3.36.0",
      "@react-aria/color": "3.1.2",
      "@react-stately/*": "3.34.0",
      "@react-types/*": "3.0.0",
      "@internationalized/date": "3.10.0",
      "@internationalized/number": "3.6.5"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "husky",
      "prisma",
      "sharp",
      "protobufjs",
      "mozjpeg",
      "optipng-bin",
      "styled-components"
    ]
  }
}
